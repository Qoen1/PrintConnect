@page "/printer/{Id:guid}/files"

@using PrintConnect.Application.Services.Device
@using PrintConnect.Application.Services.File
@using PrintConnect.Application.Services.Queue
@using PrintConnect.Domain.Entities

@inject IFileService FileService
@inject IQueueService QueueService
@inject IPrinterService PrinterService

<PrinterNavBar Printer="_printer"/>

@foreach (var file in _files)
{
    <div class="print-file-row">
        <img class="file-thumbnail"
             src="/preview.png"
             alt="@file.DisplayName" />

        <div class="file-content">

            <div class="file-name">
                @file.DisplayName
            </div>

            <div class="file-meta">

                <div class="meta-item">
                    <div class="meta-label">Printer model</div>
                    <div class="meta-value">file.PrinterModel</div>
                </div>

                <div class="meta-item">
                    <div class="meta-label">Estimated time</div>
                    <div class="meta-value">file.EstimatedTime</div>
                </div>

                <div class="meta-item">
                    <div class="meta-label">Material</div>
                    <div class="meta-value">file.Material</div>
                </div>

                <div class="meta-item">
                    <div class="meta-label">Layer height</div>
                    <div class="meta-value">file.LayerHeight</div>
                </div>

                <div class="meta-item">
                    <div class="meta-label">Date</div>
                    <div class="meta-value">dd MMM yyyy</div>
                </div>

                <div class="meta-item">
                    <div class="meta-label">Size</div>
                    <div class="meta-value">file.Size</div>
                </div>

            </div>

        </div>

        <div class="file-actions">

            <button class="print-btn" @onclick="@(async () => await AddFileToQueue($"{file.Path}/{file.Name}"))">
                <span>
                    <svg style="height: 1rem" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                        <path fill="#f97316"
                              d="M187.2 100.9C174.8 94.1 159.8 94.4 147.6 101.6C135.4 108.8 128 121.9 128 136L128 504C128 518.1 135.5 531.2 147.6 538.4C159.7 545.6 174.8 545.9 187.2 539.1L523.2 355.1C536 348.1 544 334.6 544 320C544 305.4 536 291.9 523.2 284.9L187.2 100.9z"/>
                        </svg>
                </span>
                <span>Print</span>
            </button>

        </div>

    </div>
}

    

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Printer? _printer;
    private List<PrinterFile> _files = [];

    protected override async Task OnInitializedAsync()
    {
        _printer = await PrinterService.GetPrinterInfoById(Id);
        _files = await FileService.GetPrinterFilesByIdAsync(Id);
        await base.OnInitializedAsync();
    }
    
    

    private Task AddFileToQueue(string filepath)
    {
        return QueueService.AddPrinterJobByIdAsync(Id, filepath);
    }
}