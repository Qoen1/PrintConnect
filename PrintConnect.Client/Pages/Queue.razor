@page "/printer/{Id:guid}/queue"

@using PrintConnect.Application.Services.Device
@using PrintConnect.Application.Services.Queue
@using PrintConnect.Domain.Entities

@inject IQueueService QueueService
@inject IPrinterService PrinterService

<PrinterNavBar Printer="_printer"/>

<h1>Queue</h1>

@if (_printer is not null)
{
    <h2>@_printer.Name</h2>
    <div><button @onclick="StartNextJobInQueue">start next job</button></div>
}

<ol>
    @foreach (var job in _printer?.Jobs ?? [])
    {
        <li>@job.Name</li>
    }
</ol>


@code {
    [Parameter]
    public Guid Id { get; set; }
    private Printer? _printer = null;

    protected override async Task OnInitializedAsync()
    {
        _printer = await QueueService.GetPrinterQueueByIdAsync(Id);
        await base.OnInitializedAsync();
    }

    private async Task StartNextJobInQueue()
    {
        var result = await PrinterService.StartNextJobInQueueByIdAsync(Id);
        if (result.IsSuccess)
        {
            return;
        }
        Console.WriteLine(result.Errors.Select(x => x.Message)
            .Aggregate((accumulator, item) => accumulator + "; " + item));
    }
}