@page "/printer/{Id:guid}/queue"

@using PrintConnect.Application.Services.Device
@using PrintConnect.Application.Services.Queue
@using PrintConnect.Domain.Entities

@inject IQueueService QueueService
@inject IPrinterService PrinterService

<PrinterNavBar Printer="_printer"/>

<h1>Queue</h1>

@if (_printer is not null)
{
    <h2>@_printer.Name</h2>
    <div><button @onclick="StartNextJobInQueue">start next job</button></div>
}

@foreach (var job in _printer?.Jobs ?? [])
{
    <div class="print-file-row">
        <img class="file-thumbnail"
             src="https://connect.prusa3d.com/app/teams/244177/files/OrL57tMUNT-Vzk-4-LMZgCnoYmo./preview"
             alt="@job.Name" />

        <div class="file-content">

            <div class="file-name">
                @job.Name
            </div>

            <div class="file-meta">

                <div class="meta-item">
                    <div class="meta-label">Printer model</div>
                    <div class="meta-value">file.PrinterModel</div>
                </div>

                <div class="meta-item">
                    <div class="meta-label">Estimated time</div>
                    <div class="meta-value">file.EstimatedTime</div>
                </div>

                <div class="meta-item">
                    <div class="meta-label">Material</div>
                    <div class="meta-value">file.Material</div>
                </div>

                <div class="meta-item">
                    <div class="meta-label">Layer height</div>
                    <div class="meta-value">file.LayerHeight</div>
                </div>

                <div class="meta-item">
                    <div class="meta-label">Date</div>
                    <div class="meta-value">dd MMM yyyy</div>
                </div>

                <div class="meta-item">
                    <div class="meta-label">Size</div>
                    <div class="meta-value">file.Size</div>
                </div>
            </div>
        </div>

        <div class="file-actions">

            <button class="print-btn" >
                <span>
                    <svg style="height: 1rem" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path
                            fill="#f97316" d="M232.7 69.9L224 96L128 96C110.3 96 96 110.3 96 128C96 145.7 110.3 160 128 160L512 160C529.7 160 544 145.7 544 128C544 110.3 529.7 96 512 96L416 96L407.3 69.9C402.9 56.8 390.7 48 376.9 48L263.1 48C249.3 48 237.1 56.8 232.7 69.9zM512 208L128 208L149.1 531.1C150.7 556.4 171.7 576 197 576L443 576C468.3 576 489.3 556.4 490.9 531.1L512 208z"/></svg>
                </span>
                <span>Remove</span>
            </button>

        </div>

    </div>
}


@code {
    [Parameter]
    public Guid Id { get; set; }
    private Printer? _printer = null;

    protected override async Task OnInitializedAsync()
    {
        _printer = await QueueService.GetPrinterQueueByIdAsync(Id);
        await base.OnInitializedAsync();
    }

    private async Task StartNextJobInQueue()
    {
        var result = await PrinterService.StartNextJobInQueueByIdAsync(Id);
        if (result.IsSuccess)
        {
            return;
        }
        Console.WriteLine(result.Errors.Select(x => x.Message)
            .Aggregate((accumulator, item) => accumulator + "; " + item));
    }
}